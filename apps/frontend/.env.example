# DH Araria Hospital Frontend Environment Configuration
# Copy this file to .env.local and fill in your values

# API
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ABDM (Phase 3)
NEXT_PUBLIC_ABDM_SANDBOX_URL=https://dev.abdm.gov.in/gateway

# Bhashini (Phase 3)
NEXT_PUBLIC_BHASHINI_ENABLED=false

# e-Pramaan (Phase 3)
NEXT_PUBLIC_EPRAAMAN_ENABLED=false

# Feature Flags
NEXT_PUBLIC_ENABLE_APPOINTMENTS=true
NEXT_PUBLIC_ENABLE_GRIEVANCES=true
NEXT_PUBLIC_ENABLE_BLOOD_BANK=true
NEXT_PUBLIC_ENABLE_NOTICES=true