{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.json",
    "outDir": "./dist",
    "assets": [
      {
        "include": "**/*.sql",
        "outDir": "./dist"
      }
    ]
  }
}