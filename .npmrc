# Package Manager Configuration
engine-strict=true
prefer-offline=true
audit-level=moderate
fund=false

# Workspace settings
# NOTE: do NOT set `workspaces=true` here. It is not a valid npm config key;
# npm coerces it into "run every workspace's scripts", which breaks root
# scripts (`npm run build`/`dev`) and makes them fan out in alphabetical
# order instead of running the root script. Workspaces are already declared
# in package.json and are activated by the `--workspace` flag.
install-workspace-packages=true

# Registry
registry=https://registry.npmjs.org/

# Save exact versions
save-exact=true

# Legacy peer deps (for compatibility)
# drizzle-orm declares optional peers on react-native / expo-sqlite, which want
# @types/react@19 while the Next.js frontend pins 18. npm 7+ treats those as
# hard conflicts, so a plain `npm install` fails ERESOLVE without this.
legacy-peer-deps=true

# Scripts
ignore-scripts=false