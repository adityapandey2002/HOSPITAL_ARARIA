# PostgreSQL connection string used by the worker and your site.
DATABASE_URL=postgresql://user:password@localhost:5432/yourdb

# Provider (defaults are correct for Araria)
PROVIDER_BASE_URL=https://eraktkosh.mohfw.gov.in/eraktkoshPortal
STATE_CODE=10
STATE_NAME=Bihar
DISTRICT_ID=209
DISTRICT_NAME=Araria

# Sync every 4 hours; keep 30 days of history.
SYNC_INTERVAL_MINUTES=240
RETENTION_DAYS=30

# Freshness thresholds used by the API.
FRESH_MINUTES=360
AGING_MINUTES=1440

# Shared secret for POST /api/blood/sync. Leave empty to disable the route.
ADMIN_TOKEN=

# Demo server only
PORT=8788
