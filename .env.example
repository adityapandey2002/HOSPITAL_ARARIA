# Root Environment Configuration
# Copy to .env and fill in values

# Node Environment
NODE_ENV=development

# Database (single PostgreSQL engine for the whole platform)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=dh_araria

# Dual-ORM connection pools.
# All three clients share one PostgreSQL instance, so their pool sizes must sum
# to less than the server's max_connections (200 in docker-compose.yml).
#   Prisma 10 + Drizzle 20 + MikroORM 20 = 50, leaving headroom for migrations
#   and manual psql sessions.
# Prisma uses DATABASE_URL; override DB_POOL_SIZE to change its pool.
DB_POOL_SIZE=10
DRIZZLE_POOL_SIZE=20
MIKRO_POOL_SIZE=20
# Logs every MikroORM query and emitted SQL — development only.
MIKRO_DEBUG=false

# Backend
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JWT (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Phase 3 Integrations (Optional for MVP)
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
BHASHINI_API_KEY=
BHASHINI_API_SECRET=
EPRAAMAN_CLIENT_ID=
EPRAAMAN_CLIENT_SECRET=
CPGRAMS_API_KEY=
CPGRAMS_USERNAME=
CPGRAMS_PASSWORD=
ERAKTKOSH_API_KEY=
ERAKTKOSH_BLOOD_BANK_ID=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dhararia.bihar.gov.in