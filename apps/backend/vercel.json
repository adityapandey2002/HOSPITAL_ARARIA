{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && (npm ci --include=dev --no-audit --no-fund || npm install --include=dev --no-audit --no-fund)",
  "buildCommand": "cd ../.. && npm run build --workspace=packages/shared && npm run build:backend",
  "regions": ["bom1"],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/v1/blood/cron-sync",
      "schedule": "0 */2 * * *"
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
