# DH Araria Hospital Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database — DATABASE_URL is required and is the single source of truth.
# Both Drizzle and MikroORM resolve their pool from it (see src/config/database-url.ts).
#
# Local docker-compose PostgreSQL:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dh_araria
# Supabase (project settings -> Database -> Connection string -> URI):
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dh_araria

# Optional explicit overrides. Leave unset in normal use — a managed URL already
# carries the host, credentials and database name. Useful only when you want the
# local docker container to ignore DATABASE_URL.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=dh_araria

# TLS. Leave unset to auto-detect: on for any non-local host, off for localhost.
# DB_SSL=false

# Connection pools (Drizzle + MikroORM share one PostgreSQL instance).
# Keep the sum below the server's max_connections.
DRIZZLE_POOL_SIZE=20
MIKRO_POOL_SIZE=20
MIKRO_DEBUG=false

# JWT (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100
RATE_LIMIT_AUTH_LIMIT=10

# Logging
LOG_LEVEL=info

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# ABDM Integration (Phase 3)
ABDM_SANDBOX_URL=https://dev.abdm.gov.in/gateway
ABDM_PROD_URL=https://abdm.gov.in/gateway
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# Bhashini Integration (Phase 3)
BHASHINI_API_KEY=
BHASHINI_API_SECRET=

# e-Pramaan Integration (Phase 3)
EPRAAMAN_CLIENT_ID=
EPRAAMAN_CLIENT_SECRET=
EPRAAMAN_CALLBACK_URL=http://localhost:3001/api/auth/epramaan/callback

# CPGRAMS Integration (Phase 3)
CPGRAMS_API_KEY=
CPGRAMS_USERNAME=
CPGRAMS_PASSWORD=

# e-RaktKosh Integration (Phase 3)
ERAKTKOSH_API_KEY=
ERAKTKOSH_BLOOD_BANK_ID=

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dhararia.bihar.gov.in

# Redis (for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0