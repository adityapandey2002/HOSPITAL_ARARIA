{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The app tsconfig uses "preserve" because Next.js compiles JSX itself.
    // ts-jest has no such step, so it needs to emit runnable JS.
    "jsx": "react-jsx",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "isolatedModules": false,
    "incremental": false,
    // ts-jest type-checks each test file against this program. `jest.setup.ts`
    // lives outside `include`, so its `@testing-library/jest-dom` import never
    // reaches the test files. Declaring the augmentation here makes the
    // toBeInTheDocument / toBeDisabled / toHaveClass matchers visible.
    "types": ["jest", "node", "@testing-library/jest-dom"]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "jest.setup.ts"]
}