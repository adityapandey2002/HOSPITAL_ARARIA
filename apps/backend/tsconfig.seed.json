{
  // Dedicated config for `npm run db:seed`.
  //
  // The seed lives in prisma/ (outside the backend's rootDir of ./src) and is
  // run through ts-node, so it needs its own rootDir and file set. This also
  // avoids passing --compiler-options on the command line, which Windows
  // cmd.exe mangles by stripping the inner double quotes.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "rootDir": ".",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["prisma/**/*.ts"]
}