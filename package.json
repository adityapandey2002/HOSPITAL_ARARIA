{
  "name": "blood-availability-araria",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "e-RaktKosh blood availability for Araria district: sync worker, Postgres schema, API and responsive web UI",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/cli/migrate.ts",
    "sync": "tsx src/cli/sync.ts",
    "retention": "tsx src/cli/retention.ts",
